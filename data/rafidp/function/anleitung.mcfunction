tellraw @a [{"text":"  RafiDP - Anleitung","color":"green"}]
tellraw @s [{"text":"Für diese Anleitung schreibe: "},{"text":"/function rafidp:anleitung","color":"blue"}]
tellraw @s [{"text":"  ## Brücken ##"}]
tellraw @s [{"text":"Brücken über Täler, 60 Blöcke lang. X=Ost-West, Y=Nord-Süd."}]
tellraw @s [{"text":"Fliege an den geplanten Mittelpunkt der Brücke, die dann unter dir erstellt wird. Schreibe:"}]
tellraw @s [{"text":"/function strasse:bridgex","color":"blue"},{"text":" oder ","color":"white"},{"text":"/function strasse:bridgey","color":"blue"}]
tellraw @s [{"text":"  ## Labyrinthe ##"}]
tellraw @s [{"text":"Es gibt ein 2D Labyrinth, das süd-westlich von dir in den Boden gegraben wird, wenn du auf flachem Boden stehst. Schreibe:"}]
tellraw @s [{"text":"/function mathe:labyrinth13x13","color":"blue"}]
tellraw @s [{"text":"Es gibt ein 3D Labyrinth, das süd-westlich-unter dir in einen großen Block gegraben wird, wenn du an dessen Ecke stehst/fliegst. Schreibe:"}]
tellraw @s [{"text":"/function mathe:labyrinth7x7x7","color":"blue"}]
tellraw @s [{"text":"Beide Funktionen geben auch gleich den Befehl aus, wie man einen genügend großen Steinblock erzeugt. Wenn nötig, erstelle den Block und dann das Labyrinth."}]
tellraw @s [{"text":"  ## Landschaft Straßen ##"}]
tellraw @s [{"text":"Straßenstück auf Geländehöhe, 11 Blöcke lang. X=Ost-West, Y=Nord-Süd."}]
tellraw @s [{"text":"Stell dich auf den geplanten Mittelpunkt der Straße (oder fliege darüber). Die Strasse wird dann auf Bodenhöhe erstellt. Du kannst auch zum letzten Block der vorigen Straße gehen, das passt. Schreibe:"}]
tellraw @s [{"text":"/function strasse:landschaft_strasse_x","color":"blue"},{"text":" oder ","color":"white"},{"text":"/function strasse:landschaft_strasse_y","color":"blue"}]
tellraw @s [{"text":"  ## Rundes ##"}]
tellraw @s [{"text":"Kreise und Kugeln in verschiedenen Größen. Achte auf die vorgeschlagenen Auto-Vervollständigungen."}]
tellraw @s [{"text":"Stelle dich in die Mitte und schreibe:"}]
tellraw @s [{"text":"/function rund:circle","color":"blue"},{"text":"... oder ","color":"white"},{"text":"/function rund:ball","color":"blue"},{"text":"...","color":"white"}]
tellraw @s [{"text":"  ## Stepper ##"}]
tellraw @s [{"text":"Ein Teleport System, das sich selbst erweitert."}]
tellraw @s [{"text":"Zum starten gehe z.B. genau zu 0,0 und schreibe:"}]
tellraw @s [{"text":"/function stepper:stepper100","color":"blue"}]
tellraw @s [{"text":"  ## Vulkane ##"}]
tellraw @s [{"text":"Verschieden große Vulkane"}]
tellraw @s [{"text":"Fliege z.B. 10 Blöcke in die Luft für Vulkan10. Der Vulkan wird genau über deinem Kopf generiert. Schreibe:"}]
tellraw @s [{"text":"/function vulkan:vulkan10","color":"blue"},{"text":" oder zum entfernen schreibe an der selben Stelle ","color":"white"},{"text":"/function vulkan:vulkan10air","color":"blue"}]
